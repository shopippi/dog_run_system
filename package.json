{
  "name": "dog-run-system",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @dr/liff build && pnpm --filter @dr/admin build && pnpm --filter @dr/api assets",
    "dev": "pnpm build && pnpm --filter @dr/api dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "manual:shots": "MANUAL_SHOTS=1 E2E_PORT=${E2E_PORT:-8798} playwright test e2e/manual-shots.spec.ts",
    "db:migrate:local": "pnpm --filter @dr/api db:migrate:local"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "@types/node": "^22.15.17"
  }
}
